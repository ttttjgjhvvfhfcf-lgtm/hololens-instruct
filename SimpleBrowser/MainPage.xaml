<Page
    x:Class="SimpleBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleBrowser"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Padding="8" Spacing="8">
            <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Click="BackButton_Click" IsEnabled="False" ToolTipService.ToolTip="Zurück" />
            <Button x:Name="ForwardButton" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Click="ForwardButton_Click" IsEnabled="False" ToolTipService.ToolTip="Vor" />
            <Button x:Name="ReloadButton" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="ReloadButton_Click" ToolTipService.ToolTip="Neu laden" />
            <Button x:Name="HomeButton" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" Click="HomeButton_Click" ToolTipService.ToolTip="Startseite" />
            <TextBox x:Name="AddressBar" Width="600" VerticalAlignment="Center" KeyDown="AddressBar_KeyDown" />
            <Button x:Name="GoButton" Content="Los" Click="GoButton_Click" />
        </StackPanel>

        <WebView x:Name="Browser" Grid.Row="1" />
    </Grid>
</Page>
